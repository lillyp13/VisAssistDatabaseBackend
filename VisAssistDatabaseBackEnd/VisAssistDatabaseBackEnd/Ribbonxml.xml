<?xml version="1.0" encoding="UTF-8"?>

<!--WORKING SMALL SECTION-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
	<ribbon>
		<tabs>
			<tab id="tabAddIn" label="Add In">
      
				<group id="grpDatabase" label="Database">
					<button id="btnAddDatabase" label="Add Database" onAction="btnAddDatabase_Click"/>
					<button id="btnDeleteDatabase"
						   label="Delete Database"
						   onAction="btnDeleteDatabase_Click"/>
				</group>
				<group id="grpProject" label="Project">
					<button id="btnAddProjectWithVisio"
							label="Add Project"
							onAction="btnAddProjectWithVisio_Click"/>
					<button id="btnGetProjectInfo"
							 label="Get Project Info"
							 onAction="btnGetProjectInfo_Click"/>
          <button id="btnDeleteProjectInfo"
                   label="Delete Project"
                   onAction="btnDeleteProjectInfo_Click"/>
					<button id="btnOpenProject"
						 label="Open Project"
						 onAction="btnOpenProject_Click"/>
				</group>
				<group id="grpFile" label="File">
					<button id="btnAddFile"
						 label="Add File"
						 onAction="btnAddFile_Click"/>
					<button id="btnGetFileData"
							label="Get File Data"
							onAction="btnGetFileData_Click"/>
					<button id="btnCopyAnotherFile"
						   label="Copy File"
						   onAction="btnCopyAnotherFile_Click"/>
					<button id="btnDeleteFile"
							label="Delete File"
							onAction="btnDeleteFile_Click"/>
					<button id="btnOpenFile"
						 label="Open File"
						 onAction="btnOpenFile_Click"/>
					<button id="btnChangeFileName"
						  label="Change File Name"
						  onAction="btnChangeFileName_Click"/>
				</group>
        <group id="grpTests" label="Tests">
          <button id="btnStressTest"
						 label="Stress Test"
						 onAction="btnPageAndTerminals_Click"/>
         
        </group>
        <group id="grpUtilities" label="Utilities">
          <button id="btnResetWireColorAndNumber"
						 label="Reset Wire Color and Number"
						 onAction="btnResetWireColorandNumber_Click"/>

        </group>
			</tab>
		</tabs>
	</ribbon>

	<contextMenus>
		<contextMenu idMso="ContextMenuPageTab">
			<!--Disable Built-in duplicate page control-->
   
			<!--Custom VisAssist duplicate buttons-->
			<menuSeparator id="sepCustom1"/>
			<button id="VisAssistDuplicateSinglePage"
					label="VisAssist - Duplicate Single Page"
					onAction="OnCustomDuplicateSinglePage"/>
			
			<button id="VisAssistDuplicateMultiplePages"
					label="VisAssist - Duplicate Multiple Pages"
					onAction="OnCustomDuplicateMultiplePages" />
		</contextMenu>
	</contextMenus>
</customUI>
<!--END OF WORKING SMALL SECTION-->


